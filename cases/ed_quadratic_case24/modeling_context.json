      "description": "The sum of active power generation minus the sum of active power load and outgoing branch flows must equal zero at each bus for each time period.",
      "type": "physical_law",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Kirchhoff's Current Law for DC power flow."
      }
    },
    {
      "id": "c_007",
      "name": "DCPowerFlowEquation",
      "description": "The active power flow on each branch is determined by the voltage angle difference between its from-bus and to-bus divided by its reactance.",
      "type": "physical_law",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Kirchhoff's Voltage Law and Ohm's Law for DC power flow approximation."
      }
    },
    {
      "id": "c_008",
      "name": "BranchFlowUpperLimit",
      "description": "The active power flow on each branch must be less than or equal to its long-term thermal rating.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Prevent thermal overloading of transmission lines."
      }
    },
    {
      "id": "c_009",
      "name": "BranchFlowLowerLimit",
      "description": "The active power flow on each branch must be greater than or equal to the negative of its long-term thermal rating.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Prevent thermal overloading of transmission lines in the reverse direction."
      }
    },
    {
      "id": "c_010",
      "name": "ReferenceBusAngle",
      "description": "The voltage angle of the reference bus must be fixed to zero for all time periods.",
      "type": "physical_law",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Establish a reference angle for the DC power flow equations."
      }
    },
    {
      "id": "c_011",
      "name": "SystemReserveRequirement",
      "description": "The total available online generation capacity minus the total active power output must be greater than or equal to the required reserve fraction of the total system load for each time period.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Ensure sufficient spinning reserve to handle load fluctuations and contingencies."
      }
    }
