  "objective": {
    "id": "obj_1",
    "name": "MinimizeGenerationCost",
    "sense": "minimize",
    "description": "Minimize the total quadratic, linear, and no-load generation costs over all generators and time periods.",
    "terms": [
      {
        "description": "Quadratic generation cost proportional to the square of active power output"
      },
      {
        "description": "Linear generation cost proportional to active power output"
      },
      {
        "description": "Fixed no-load generation cost for online generators"
      }
    ]
  },
