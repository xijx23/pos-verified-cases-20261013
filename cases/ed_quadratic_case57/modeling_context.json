  "objective": {
    "id": "obj_1",
    "name": "MinimizeQuadraticGenerationCost",
    "sense": "minimize",
    "description": "Minimize the total quadratic generation cost over all generators and time periods.",
    "terms": [
      {
        "description": "Quadratic generation cost component"
      },
      {
        "description": "Linear marginal generation cost component"
      },
      {
        "description": "Fixed no-load generation cost component"
      }
    ]
  },
  "constraints": [
    {
      "id": "c_001",
      "name": "GeneratorActivePowerLimits",
      "description": "Active power output of available generators must be within minimum and maximum limits.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Physical and operational limits of generators"
      }
    },
    {
      "id": "c_002",
      "name": "UnavailableGeneratorZeroOutput",
      "description": "Active power output of unavailable generators must be exactly zero.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Unavailable generators cannot produce power"
      }
    },
    {
      "id": "c_003",
      "name": "GeneratorRampUpLimit",
      "description": "The increase in active power output between consecutive time periods cannot exceed the ramp up limit.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Physical ramping capability of generators"
      }
    },
    {
      "id": "c_004",
      "name": "GeneratorRampDownLimit",
      "description": "The decrease in active power output between consecutive time periods cannot exceed the ramp down limit.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Physical ramping capability of generators"
      }
    },
    {
      "id": "c_005",
      "name": "NodalActivePowerBalance",
      "description": "The total active power generation minus the total active power demand and net branch flow at each bus must equal zero for each time period.",
      "type": "physical_law",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Kirchhoff's current law"
      }
    },
    {
      "id": "c_006",
      "name": "DCBranchFlowEquation",
      "description": "The active power flow on each available branch is determined by the phase angle difference between the from and to buses divided by the branch reactance.",
      "type": "physical_law",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "DC power flow approximation of Kirchhoff's voltage law"
      }
    },
    {
      "id": "c_007",
      "name": "BranchThermalLimits",
      "description": "The absolute active power flow on each branch must not exceed its long-term thermal rating.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Prevent thermal overloading of transmission lines"
      }
    },
    {
      "id": "c_008",
      "name": "ReferenceBusAngle",
      "description": "The voltage phase angle of the reference bus must be fixed to zero for each time period.",
      "type": "physical_law",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Provide a reference angle for the DC power flow equations"
      }
    },
    {
      "id": "c_009",
      "name": "UnavailableBranchZeroFlow",
      "description": "The active power flow on unavailable branches must be exactly zero.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Unavailable branches cannot carry power"
      }
    }
  ],
