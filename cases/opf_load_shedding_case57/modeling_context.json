      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "DC power flow approximation."
      }
    },
    {
      "id": "c_005",
      "name": "BranchFlowLimits",
      "description": "Power flow on each branch must be within its thermal rating limits.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Thermal limits of transmission lines."
      }
    },
    {
      "id": "c_006",
      "name": "ReferenceBusAngle",
      "description": "Voltage angle of the reference bus must be set to zero for each time period.",
      "type": "physical_law",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Reference angle definition."
      }
    },
    {
      "id": "c_007",
      "name": "GeneratorRampingLimits",
