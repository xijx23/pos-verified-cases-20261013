  "constraints": [
    {
      "id": "c_001",
      "name": "GeneratorOutputLimits",
      "description": "Active power output of available generators must be within minimum and maximum limits, and must be zero for unavailable generators.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Physical and operational limits of generators."
      }
    },
    {
      "id": "c_002",
      "name": "LoadSheddingLimits",
      "description": "Load shedding at each bus must be non-negative and cannot exceed the actual load at that bus and time period.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Cannot shed more load than exists."
      }
    },
    {
      "id": "c_003",
      "name": "NodalPowerBalance",
      "description": "Net power injection from generators minus load shedding must equal the net power flow out of the bus for each time period.",
      "type": "physical_law",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Kirchhoff's Current Law."
      }
    },
    {
      "id": "c_004",
      "name": "DCPowerFlowEquations",
      "description": "Branch power flow is determined by the voltage angle difference between from and to buses divided by branch reactance.",
