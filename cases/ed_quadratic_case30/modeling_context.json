  "constraints": [
    {
      "id": "c_001",
      "name": "OnlineGeneratorLowerBound",
      "description": "Active power output of online generators must be greater than or equal to their minimum capacity limits.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Physical and operational minimum stable generation limits of online generators."
      }
    },
    {
      "id": "c_002",
      "name": "OnlineGeneratorUpperBound",
      "description": "Active power output of online generators must be less than or equal to their maximum capacity limits.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Physical and operational maximum capacity limits of online generators."
      }
    },
    {
      "id": "c_003",
      "name": "OfflineGeneratorZeroOutput",
      "description": "Active power output of offline generators must be exactly zero.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Offline generators are unavailable and cannot produce power."
      }
    },
    {
      "id": "c_004",
      "name": "GeneratorRampUpLimit",
      "description": "The increase in active power output of each generator between consecutive time periods cannot exceed 30% of its maximum capacity.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Physical ramping limitations of generators during power increase."
      }
    },
    {
      "id": "c_005",
      "name": "GeneratorRampDownLimit",
      "description": "The decrease in active power output of each generator between consecutive time periods cannot exceed 30% of its maximum capacity.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Physical ramping limitations of generators during power decrease."
      }
    },
    {
      "id": "c_006",
      "name": "DCNodalPowerBalance",
      "description": "The total power injected by generators at each bus must equal the sum of power flows leaving the bus minus power flows entering the bus plus the local load at each time period.",
      "type": "physical_law",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Kirchhoff's current law applied to DC power flow network."
      }
    },
    {
      "id": "c_007",
      "name": "DCBranchFlowDefinition",
      "description": "The active power flow on each branch is defined by the phase angle difference between its from-bus and to-bus divided by its reactance.",
      "type": "physical_law",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Kirchhoff's voltage law and Ohm's law applied to DC power flow network."
      }
    },
    {
      "id": "c_008",
      "name": "BranchFlowUpperLimit",
      "description": "The active power flow on each branch must not exceed its long-term thermal rating.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Prevent overheating and damage to transmission lines in the forward direction."
      }
    },
    {
      "id": "c_009",
      "name": "BranchFlowLowerLimit",
      "description": "The active power flow on each branch must not be less than the negative of its long-term thermal rating.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Prevent overheating and damage to transmission lines in the reverse direction."
      }
    },
    {
      "id": "c_010",
      "name": "ReferenceBusAngle",
      "description": "The voltage phase angle of the reference bus must be fixed to zero at all time periods.",
      "type": "physical_law",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Establish a unique reference angle for the DC power flow model."
      }
    }
  ],
