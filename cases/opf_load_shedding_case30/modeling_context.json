  "objective": {
    "id": "obj_1",
    "name": "MinimizeFuelAndSheddingCost",
    "sense": "minimize",
    "description": "Minimize the total linear fuel cost of generators and the penalty cost for load shedding across all time periods.",
    "terms": [
      {
        "description": "Linear fuel cost of active power generation"
      },
      {
        "description": "Penalty cost for load shedding"
      }
    ]
  },
  "constraints": [
    {
      "id": "c_001",
      "name": "AvailableGeneratorMinimumOutput",
      "description": "Active power output of available generators must be greater than or equal to their minimum generation limit.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Physical and operational limits of generators must be strictly respected."
      }
    },
    {
      "id": "c_002",
      "name": "AvailableGeneratorMaximumOutput",
      "description": "Active power output of available generators must be less than or equal to their maximum generation limit.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Physical and operational limits of generators must be strictly respected."
      }
    },
    {
      "id": "c_003",
      "name": "UnavailableGeneratorZeroOutput",
      "description": "Active power output of unavailable generators must be exactly zero.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Unavailable generators cannot produce power."
      }
    },
    {
      "id": "c_004",
      "name": "LoadSheddingUpperBound",
      "description": "Load shedding at each bus cannot exceed the actual active power demand at that bus and time period.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Cannot shed more load than what is actually demanded."
      }
    },
    {
      "id": "c_005",
      "name": "NodalActivePowerBalance",
      "description": "Total active power generation minus active power demand plus load shedding must equal the net active power injection from connected branches at each bus and time period.",
      "type": "physical_law",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Kirchhoff's current law must be satisfied at every node."
      }
    },
    {
      "id": "c_006",
      "name": "DCPowerFlowEquation",
      "description": "Active power flow on each branch is determined by the voltage angle difference between its from-bus and to-bus divided by its reactance, scaled by the system base power.",
      "type": "physical_law",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Standard DC power flow approximation relating flows to voltage angles."
      }
    },
    {
      "id": "c_007",
      "name": "BranchThermalLimits",
      "description": "Active power flow on available branches must be within their long-term thermal ratings in both directions.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Prevent transmission line overheating and equipment damage."
      }
    },
    {
      "id": "c_008",
      "name": "UnavailableBranchZeroFlow",
      "description": "Active power flow on unavailable branches must be exactly zero.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Out-of-service branches cannot carry power flow."
      }
    },
    {
      "id": "c_009",
      "name": "ReferenceBusVoltageAngle",
      "description": "The voltage angle of the reference bus must be fixed to zero at all time periods.",
      "type": "physical_law",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Provides a necessary reference point for the voltage angle system."
      }
    },
    {
      "id": "c_010",
      "name": "GeneratorRampUpLimit",
      "description": "The increase in active power output of a generator between consecutive time periods cannot exceed its ramp-up limit.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Physical limitations on how fast a generator can increase its output."
      }
    },
    {
      "id": "c_011",
      "name": "GeneratorRampDownLimit",
      "description": "The decrease in active power output of a generator between consecutive time periods cannot exceed its ramp-down limit.",
      "type": "operational_requirement",
      "metadata": {
        "relaxation_policy": "hard",
        "penalty": null,
        "reason": "Physical limitations on how fast a generator can decrease its output."
      }
    }
  ],
